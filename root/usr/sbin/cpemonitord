#!/bin/sh
. /lib/functions.sh

RAM_DIR=/tmp/cpemonitor
mkdir -p "$RAM_DIR"

load_config() {
	config_load cpemonitor
	config_get IFACE main interface wwan0
	config_get SAMPLE main sample_interval 10
	config_get MODEM_SAMPLE main modem_interval 60
	config_get PERSIST main persist_interval 21600
	config_get RETENTION main retention_days 365
	config_get DATA_DIR main data_dir /overlay/cpemonitor
	config_get ALI_HOST main aliyun_host 223.5.5.5
	config_get TEN_HOST main tencent_host 119.29.29.29
	config_get PING_COUNT main ping_count 1
	config_get PING_TIMEOUT main ping_timeout 2
	config_get_bool QUOTA_ENABLED main quota_enabled 0
	FAN_PWM_FILE="$(uci -q get fancontrol.settings.fan_file)"
	FAN_MAX="$(uci -q get fancontrol.settings.max_speed)"
	[ -n "$FAN_PWM_FILE" ] || FAN_PWM_FILE=/sys/class/hwmon/hwmon2/pwm1
	[ "$FAN_MAX" -gt 0 ] 2>/dev/null || FAN_MAX=255
	[ "$SAMPLE" -ge 2 ] 2>/dev/null || SAMPLE=10
	[ "$MODEM_SAMPLE" -ge "$SAMPLE" ] 2>/dev/null || MODEM_SAMPLE=$SAMPLE
	[ "$PERSIST" -ge 60 ] 2>/dev/null || PERSIST=21600
	[ "$RETENTION" -ge 35 ] 2>/dev/null || RETENTION=35
}

# Follow the active MU300 bearer without changing the user's configured interface.
resolve_iface() {
	[ -x /opt/mu300/bin/mu300-modemd ] || return
	local dev
	dev=$(ubus -t 2 call network.interface.wan status 2>/dev/null | jsonfilter -e '@.l3_device')
	case "$dev" in ''|*[!a-zA-Z0-9_.-]*) return;; esac
	[ -d "/sys/class/net/$dev" ] && IFACE=$dev
}
read_traffic() {
	local f dev
	set -- $(
		if [ -x /opt/mu300/bin/mu300-modemd ]; then
			for f in /sys/class/net/sipa_eth*/statistics/rx_bytes; do
				[ -f "$f" ] || continue; dev=${f%/statistics/rx_bytes}; dev=${dev##*/}
				printf '%s %s %s\n' "$dev" "$(cat "$f")" "$(cat "/sys/class/net/$dev/statistics/tx_bytes")"
			done
		else printf '%s %s %s\n' "$IFACE" "$(read_counter rx_bytes)" "$(read_counter tx_bytes)"; fi |
		awk -v previous="$COUNTERS" -v active="$IFACE" -f /usr/lib/cpemonitor/traffic-delta.awk
	)
	DRX=${1:-0}; DTX=${2:-0}; TRAFFIC_MIXED=${3:-0}; COUNTERS=$4
}

num() { echo "$1" | grep -Eo -- '-?[0-9]+([.][0-9]+)?' | head -1; }
read_counter() { cat "/sys/class/net/$IFACE/statistics/$1" 2>/dev/null || echo 0; }

ping_host() {
	local out
	out="$(ping -c "$PING_COUNT" -W "$PING_TIMEOUT" "$1" 2>/dev/null)"
	PING_MS="$(echo "$out" | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -1)"
	[ -n "$PING_MS" ] || PING_MS=-1
	PING_LOSS="$(echo "$out" | sed -n 's/.* \([0-9]*\)% packet loss.*/\1/p' | head -1)"
	[ -n "$PING_LOSS" ] || PING_LOSS=100
}

read_cpu() {
	set -- $(head -1 /proc/stat)
	local user=$2 nice=$3 sys=$4 idle=$5 iowait=$6 irq=$7 soft=$8 steal=$9
	CPU_IDLE=$((idle + iowait)); CPU_TOTAL=$((user + nice + sys + idle + iowait + irq + soft + steal))
	if [ -n "$LAST_CPU_TOTAL" ] && [ "$CPU_TOTAL" -gt "$LAST_CPU_TOTAL" ]; then
		CPU_PCT=$((100 * ((CPU_TOTAL - LAST_CPU_TOTAL) - (CPU_IDLE - LAST_CPU_IDLE)) / (CPU_TOTAL - LAST_CPU_TOTAL)))
	else CPU_PCT=0; fi
	LAST_CPU_TOTAL=$CPU_TOTAL; LAST_CPU_IDLE=$CPU_IDLE
}

read_memory() {
	local total avail
	total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
	avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
	[ "$total" -gt 0 ] && MEM_PCT=$((100 * (total - avail) / total)) || MEM_PCT=0
}

read_temps() {
	local t
	t="$(/sbin/tempinfo 2>/dev/null)"
	CPU_TEMP="$(echo "$t" | sed -n 's/.*CPU: *\([0-9.]*\).*/\1/p')"
	WIFI_TEMP="$(echo "$t" | sed -n 's/.*WiFi: *\([0-9.]*\).*/\1/p')"
	if [ -z "$CPU_TEMP" ] && [ -x /opt/mu300/bin/mu300-modemd ]; then
		local zone kind raw
		for zone in /sys/class/thermal/thermal_zone*; do
			kind=$(cat "$zone/type" 2>/dev/null)
			case "$kind" in *cpu*|*soc*|*ap-thermal*)
				raw=$(cat "$zone/temp" 2>/dev/null)
				CPU_TEMP=$(printf '%s' "$raw" | awk '/^[0-9]+$/ {printf "%.1f", $1/1000}')
				[ -n "$CPU_TEMP" ] && break;;
			esac
		done
	fi
	[ -n "$CPU_TEMP" ] || CPU_TEMP=-1
	[ -n "$WIFI_TEMP" ] || WIFI_TEMP=-1
}

read_fan() {
	FAN_PWM="$(cat "$FAN_PWM_FILE" 2>/dev/null)"
	[ "$FAN_PWM" -ge 0 ] 2>/dev/null || FAN_PWM=0
	FAN_PCT=$((100 * FAN_PWM / FAN_MAX)); [ "$FAN_PCT" -le 100 ] || FAN_PCT=100
}

read_modem() {
	local j modem_temp
	if [ -x /opt/mu300/bin/mu300-modemd ]; then
		local slot cache stamp tmp
		slot=$(cat /run/mu300-data-sim-actual 2>/dev/null)
		cache=/tmp/unisoc-modem/sig.json
		[ "$slot" = 1 ] && cache=/tmp/unisoc-modem/sim1/sig.json
		stamp=$(date +%s); tmp="$RAM_DIR/band-current.new"
		j=$(ucode /usr/lib/cpemonitor/mu300.uc "$stamp" < "$cache" 2>/dev/null)
		RSRP=$(printf '%s' "$j" | jsonfilter -e '@.rsrp'); RSRP=${RSRP:--999}
		RSRQ=$(printf '%s' "$j" | jsonfilter -e '@.rsrq'); RSRQ=${RSRQ:--999}
		SINR=$(printf '%s' "$j" | jsonfilter -e '@.sinr'); SINR=${SINR:--999}
		MODEM_TEMP=-1
		printf '%s' "$j" | ucode /usr/lib/cpemonitor/bands.uc normalize "$stamp" mu300 "$MODEM_SAMPLE" > "$tmp"
		[ -s "$tmp" ] && ucode /usr/lib/cpemonitor/bands.uc retain "$RAM_DIR/band-current.json" < "$tmp" > "$RAM_DIR/band-current.ready" && mv "$RAM_DIR/band-current.ready" "$RAM_DIR/band-current.json"
		[ -s "$RAM_DIR/band-current.json" ] && cat "$RAM_DIR/band-current.json" >> "$RAM_DIR/bands-$(date +%F).jsonl"
		rm -f "$tmp"
		return
	fi
	j="$(ubus -t 10 call modem_ctrl info 2>/dev/null)"
	modem_temp="$(echo "$j" | jsonfilter -e '@.info[0].modem_info[@.key="temperature"].value' 2>/dev/null | head -1)"
	RSRP="$(echo "$j" | jsonfilter -e '@.info[0].modem_info[@.key="RSRP"].value' 2>/dev/null | head -1)"
	RSRQ="$(echo "$j" | jsonfilter -e '@.info[0].modem_info[@.key="RSRQ"].value' 2>/dev/null | head -1)"
	SINR="$(echo "$j" | jsonfilter -e '@.info[0].modem_info[@.key="SINR"].value' 2>/dev/null | head -1)"
	modem_temp="$(num "$modem_temp")"
	# Missing readings and the provider's -1 sentinel must not replace a valid temperature.
	if [ -n "$modem_temp" ] && [ "$modem_temp" != -1 ]; then MODEM_TEMP=$modem_temp; fi
	RSRP="$(num "$RSRP")"; RSRQ="$(num "$RSRQ")"; SINR="$(num "$SINR")"
	[ -n "$MODEM_TEMP" ] || MODEM_TEMP=-1; [ -n "$RSRP" ] || RSRP=-999
	[ -n "$RSRQ" ] || RSRQ=-999; [ -n "$SINR" ] || SINR=-999
	local stamp tmp sections section cell port first=1
	stamp=$(date +%s); tmp="$RAM_DIR/band-current.new"
	printf '%s' "$j" | ucode /usr/lib/cpemonitor/bands.uc normalize "$stamp" modem_ctrl "$MODEM_SAMPLE" > "$tmp"
	# A provider may omit serving-cell fields or be temporarily unreadable.
	# Ask QModem's generic cell interface, never vendor-specific AT commands.
	if ! jsonfilter -i "$tmp" -e '@.modems[*].bands[0]' 2>/dev/null | grep -q .; then
		sections=$(uci -q show qmodem | sed -n 's/^qmodem\.\([^.=]*\)=modem-device$/\1/p')
		if [ -n "$sections" ]; then
			printf '[' > "$RAM_DIR/band-provider.tmp"
			for section in $sections; do
				case "$section" in *[!a-zA-Z0-9_-]*) continue;; esac
				cell=$(ubus -t 8 call qmodem cell_info "{\"config_section\":\"$section\"}" 2>/dev/null)
				port=$(uci -q get "qmodem.$section.at_port")
				case "$port" in ''|*[!a-zA-Z0-9/_:.-]*) port=$section;; esac
				[ -n "$cell" ] || cell='{}'
				[ "$first" = 1 ] || printf ',' >> "$RAM_DIR/band-provider.tmp"; first=0
				printf '{"id":"%s","config_section":"%s","data":%s}' "$port" "$section" "$cell" >> "$RAM_DIR/band-provider.tmp"
			done
			printf ']' >> "$RAM_DIR/band-provider.tmp"
			ucode /usr/lib/cpemonitor/bands.uc normalize "$(date +%s)" qmodem "$MODEM_SAMPLE" < "$RAM_DIR/band-provider.tmp" > "$tmp"
			rm -f "$RAM_DIR/band-provider.tmp"
		fi
	fi
	if [ -s "$tmp" ]; then
		ucode /usr/lib/cpemonitor/bands.uc retain "$RAM_DIR/band-current.json" < "$tmp" > "$RAM_DIR/band-retained.new" && mv "$RAM_DIR/band-retained.new" "$tmp"
		mv "$tmp" "$RAM_DIR/band-current.json"
		cat "$RAM_DIR/band-current.json" >> "$RAM_DIR/bands-$(date +%F).jsonl"
	fi
}

save_state() {
	echo "$DAY $DAY_RX $DAY_TX $PREV_RX $PREV_TX $BOOT_ID $IFACE $LAST_CARRIER $COUNTERS" > "$DATA_DIR/state.new" && mv "$DATA_DIR/state.new" "$DATA_DIR/state"
	LAST_STATE=$(date +%s)
}

checkpoint() {
	mkdir -p "$DATA_DIR/samples"
	for f in "$RAM_DIR"/samples-*.csv; do
		[ -f "$f" ] || continue
		base="$(basename "$f")"
		[ -f "$DATA_DIR/samples/$base" ] || echo 'timestamp,down_bps,up_bps,cpu_pct,mem_pct,cpu_temp,wifi_temp,modem_temp,ping_aliyun_ms,loss_aliyun_pct,ping_tencent_ms,loss_tencent_pct,load1,disk_pct,rsrp,rsrq,sinr,fan_pct,carrier,download_delta,upload_delta' > "$DATA_DIR/samples/$base"
		cat "$f" >> "$DATA_DIR/samples/$base" && : > "$f"
	done
	[ -f "$RAM_DIR/daily.csv" ] && { [ -f "$DATA_DIR/daily.csv" ] || echo 'date,download_bytes,upload_bytes,total_bytes' > "$DATA_DIR/daily.csv"; cat "$RAM_DIR/daily.csv" >> "$DATA_DIR/daily.csv" && : > "$RAM_DIR/daily.csv"; }
	mkdir -p "$DATA_DIR/bands"
	for f in "$RAM_DIR"/bands-*.jsonl; do
		[ -f "$f" ] || continue
		cat "$f" >> "$DATA_DIR/bands/$(basename "$f")" && : > "$f"
	done
	save_state
	sync
	find "$DATA_DIR/samples" -type f -mtime "+$RETENTION" -delete 2>/dev/null
	find "$DATA_DIR/bands" -type f -mtime "+$RETENTION" -delete 2>/dev/null
	LAST_PERSIST=$(date +%s)
}

load_config; resolve_iface; mkdir -p "$DATA_DIR"
COUNTERS=; LAST_CARRIER=0
NOW=$(date +%s); LAST_PERSIST=$NOW; LAST_STATE=$NOW; LAST_MODEM=0
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id)
RX=$(read_counter rx_bytes); TX=$(read_counter tx_bytes); PREV_RX=$RX; PREV_TX=$TX
DAY=$(date +%F); DAY_RX=0; DAY_TX=0
if [ -f "$DATA_DIR/state" ]; then
	read OLD_DAY OLD_RX OLD_TX OLD_PREV_RX OLD_PREV_TX OLD_BOOT OLD_IFACE OLD_CARRIER OLD_COUNTERS < "$DATA_DIR/state"
	if [ "$OLD_DAY" = "$DAY" ]; then DAY_RX=$OLD_RX; DAY_TX=$OLD_TX; fi
	# Recover yesterday's last minute checkpoint after a power loss at midnight.
	if [ -n "$OLD_DAY" ] && [ "$OLD_DAY" \< "$DAY" ] &&
	   ! awk -F, -v d="$OLD_DAY" '$1 == d { found=1 } END { exit !found }' "$DATA_DIR/daily.csv" 2>/dev/null; then
		[ -f "$DATA_DIR/daily.csv" ] || echo 'date,download_bytes,upload_bytes,total_bytes' > "$DATA_DIR/daily.csv"
		echo "$OLD_DAY,$OLD_RX,$OLD_TX,$((OLD_RX + OLD_TX))" >> "$DATA_DIR/daily.csv"
	fi
	if [ "$OLD_BOOT" = "$BOOT_ID" ] && [ "$OLD_DAY" = "$DAY" ]; then
		[ "$RX" -ge "$OLD_PREV_RX" ] && PREV_RX=$OLD_PREV_RX
		[ "$TX" -ge "$OLD_PREV_TX" ] && PREV_TX=$OLD_PREV_TX
	fi
fi
if [ "$OLD_BOOT" = "$BOOT_ID" ] && [ "$OLD_DAY" = "$DAY" ]; then
	COUNTERS=$OLD_COUNTERS; LAST_CARRIER=${OLD_CARRIER:-0}
	[ -n "$COUNTERS" ] || COUNTERS="${OLD_IFACE:-$IFACE}:$PREV_RX:$PREV_TX"
fi
# Establish baselines for newly seen ports, so lifetime counters are not recounted.
[ -n "$COUNTERS" ] || read_traffic
read_cpu; read_modem

trap 'checkpoint; /usr/sbin/cpemonitor-quota cleanup >/dev/null; exit 0' TERM INT
while :; do
	START=$(date +%s); CUR_DAY=$(date +%F)
	resolve_iface
	CARRIER=$(/usr/libexec/cpemonitor-carrier sample); case "$CARRIER" in [0-6]) ;; *) CARRIER=0;; esac
	read_traffic
	RX=$(read_counter rx_bytes); TX=$(read_counter tx_bytes); PREV_RX=$RX; PREV_TX=$TX
	ROW_CARRIER=$CARRIER
	[ "$CARRIER" = "$LAST_CARRIER" ] && [ "$TRAFFIC_MIXED" = 0 ] || ROW_CARRIER=6
	if [ "$CUR_DAY" != "$DAY" ]; then
		echo "$DAY,$DAY_RX,$DAY_TX,$((DAY_RX + DAY_TX))" >> "$RAM_DIR/daily.csv"
		DAY=$CUR_DAY; DAY_RX=0; DAY_TX=0
	fi
	DAY_RX=$((DAY_RX + DRX)); DAY_TX=$((DAY_TX + DTX))
	DOWN_BPS=$((DRX * 8 / SAMPLE)); UP_BPS=$((DTX * 8 / SAMPLE))
	read_cpu; read_memory; read_temps; read_fan
	ping_host "$ALI_HOST"; ALI_MS=$PING_MS; ALI_LOSS=$PING_LOSS
	ping_host "$TEN_HOST"; TEN_MS=$PING_MS; TEN_LOSS=$PING_LOSS
	if [ $((START - LAST_MODEM)) -ge "$MODEM_SAMPLE" ]; then read_modem; LAST_MODEM=$START; fi
	AFTER_CARRIER=$(/usr/libexec/cpemonitor-carrier sample)
	[ "$AFTER_CARRIER" = "$CARRIER" ] || ROW_CARRIER=6
	LAST_CARRIER=$AFTER_CARRIER
	LOAD1=$(awk '{print $1}' /proc/loadavg)
	DISK_PCT=$(df -P "$DATA_DIR" | awk 'NR==2{gsub(/%/,"",$5);print $5}')
	echo "$START,$DOWN_BPS,$UP_BPS,$CPU_PCT,$MEM_PCT,$CPU_TEMP,$WIFI_TEMP,$MODEM_TEMP,$ALI_MS,$ALI_LOSS,$TEN_MS,$TEN_LOSS,$LOAD1,$DISK_PCT,$RSRP,$RSRQ,$SINR,$FAN_PCT,$ROW_CARRIER,$DRX,$DTX" >> "$RAM_DIR/samples-$DAY.csv"
	echo "$START $DAY_RX $DAY_TX $DOWN_BPS $UP_BPS $CPU_PCT $MEM_PCT $CPU_TEMP $WIFI_TEMP $MODEM_TEMP $ALI_MS $TEN_MS $LOAD1 $DISK_PCT $RSRP $RSRQ $SINR $FAN_PCT" > "$RAM_DIR/current"
	/usr/sbin/cpemonitor-quota update "$DAY" "$DAY_RX" "$DAY_TX" >/dev/null
	[ "$QUOTA_ENABLED" = 1 ] && [ $((START - LAST_STATE)) -ge 60 ] && save_state
	[ $((START - LAST_PERSIST)) -ge "$PERSIST" ] && checkpoint
	ELAPSED=$(($(date +%s) - START)); SLEEP=$((SAMPLE - ELAPSED)); [ "$SLEEP" -gt 0 ] || SLEEP=1
	# Waiting on a child lets TERM interrupt promptly and flush accounting.
	sleep "$SLEEP" & wait $!
done
