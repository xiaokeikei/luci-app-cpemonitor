#!/bin/sh
. /usr/share/libubox/jshn.sh

current() {
	set -- $(cat /tmp/cpemonitor/current 2>/dev/null)
	json_init
	json_add_int timestamp "${1:-0}"; json_add_int day_download "${2:-0}"; json_add_int day_upload "${3:-0}"
	json_add_int down_bps "${4:-0}"; json_add_int up_bps "${5:-0}"; json_add_int cpu_pct "${6:-0}"; json_add_int mem_pct "${7:-0}"
	json_add_double cpu_temp "${8:--1}"; json_add_double wifi_temp "${9:--1}"; shift 9
	json_add_double modem_temp "${1:--1}"; json_add_double aliyun_ms "${2:--1}"; json_add_double tencent_ms "${3:--1}"
	json_add_double load1 "${4:-0}"; json_add_int disk_pct "${5:-0}"; json_add_double rsrp "${6:--999}"; json_add_double rsrq "${7:--999}"; json_add_double sinr "${8:--999}"
	json_add_int fan_pct "${9:-0}"
	json_dump
}

history() {
	json_load "$(cat)" 2>/dev/null
	json_get_var start start; json_get_var end end; json_get_var limit limit
	now=$(date +%s); [ "$end" -gt 0 ] 2>/dev/null || end=$now
	[ "$start" -gt 0 ] 2>/dev/null || start=$((end - 600))
	[ "$start" -le "$end" ] || { t=$start; start=$end; end=$t; }
	[ "$limit" -ge 10 ] 2>/dev/null || limit=1200; [ "$limit" -le 5000 ] || limit=5000
	data_dir=$(uci -q get cpemonitor.main.data_dir); [ -n "$data_dir" ] || data_dir=/overlay/cpemonitor
	tmp=/tmp/cpemonitor/rpc-history.$$; raw=$tmp.raw; : > "$raw"
	day_epoch=$((start - start % 86400 - 86400))
	while [ "$day_epoch" -le $((end + 86400)) ]; do
		day=$(date -d "@$day_epoch" +%F 2>/dev/null)
		[ -n "$day" ] && { cat "$data_dir/samples/samples-$day.csv" 2>/dev/null; cat "/tmp/cpemonitor/samples-$day.csv" 2>/dev/null; } >> "$raw"
		day_epoch=$((day_epoch + 86400))
	done
	awk -F, -v s="$start" -v e="$end" '$1 ~ /^[0-9]+$/ && $1 >= s && $1 <= e' "$raw" > "$tmp"
	count=$(wc -l < "$tmp"); step=$(((count + limit - 1) / limit)); [ "$step" -ge 1 ] || step=1
	printf '{"rows":['; first=1
	awk -v step="$step" 'NR == 1 || NR % step == 0 { print }' "$tmp" | while IFS= read -r line; do [ -n "$line" ] || continue; [ "$first" = 1 ] || printf ','; first=0; printf '[%s]' "$line"; done
	printf ']}'
	rm -f "$tmp" "$raw"
}

daily() {
	data_dir=$(uci -q get cpemonitor.main.data_dir); [ -n "$data_dir" ] || data_dir=/overlay/cpemonitor
	printf '{"rows":['; first=1
	{
		cat "$data_dir/daily.csv" /tmp/cpemonitor/daily.csv 2>/dev/null
		set -- $(cat /tmp/cpemonitor/current 2>/dev/null)
		[ "$#" -ge 3 ] && printf '%s,%s,%s,%s\n' "$(date +%F)" "$2" "$3" "$(($2 + $3))"
	} | awk -F, '$1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $4 ~ /^[0-9]+$/ { rows[$1]=$0 } END { for (d in rows) print rows[d] }' | sort | while IFS=, read -r d rx tx total; do
		[ -n "$d" ] || continue; [ "$first" = 1 ] || printf ','; first=0; printf '["%s",%s,%s,%s]' "$d" "$rx" "$tx" "$total"
	done
	printf ']}'
}

band_history() {
	json_load "$(cat)"; json_get_var start start; json_get_var end end; json_get_var limit limit
	[ "$end" -gt 0 ] 2>/dev/null || end=$(date +%s)
	[ "$start" -gt 0 ] 2>/dev/null || start=$((end - 600))
	[ "$start" -le "$end" ] || { t=$start; start=$end; end=$t; }
	[ "$limit" -ge 10 ] 2>/dev/null || limit=5000; [ "$limit" -le 5000 ] || limit=5000
	data_dir=$(uci -q get cpemonitor.main.data_dir); [ -n "$data_dir" ] || data_dir=/overlay/cpemonitor
	{
		day_epoch=$((start - start % 86400 - 86400))
		while [ "$day_epoch" -le $((end + 86400)) ]; do
			day=$(date -d "@$day_epoch" +%F 2>/dev/null)
			[ -n "$day" ] && { cat "$data_dir/bands/bands-$day.jsonl" 2>/dev/null; cat "/tmp/cpemonitor/bands-$day.jsonl" 2>/dev/null; }
			day_epoch=$((day_epoch + 86400))
		done
	} | ucode /usr/lib/cpemonitor/bands.uc history "$start" "$end" "$limit"
}

case "$1" in
	list) echo '{"current":{},"history":{"start":"Integer","end":"Integer","limit":"Integer"},"daily":{},"monthly":{},"radio":{},"band_history":{"start":"Integer","end":"Integer","limit":"Integer"},"quota_action":{"action":"String"}}' ;;
	call) case "$2" in
		current) current;; history) history;; daily) daily;;
		monthly) cat /tmp/cpemonitor/monthly.json 2>/dev/null || echo '{}' ;;
		radio) cat /tmp/cpemonitor/band-current.json 2>/dev/null || echo '{}' ;;
		band_history) band_history ;;
		quota_action)
			json_load "$(cat)"; json_get_var action action
			case "$action" in unlock|resume) /usr/sbin/cpemonitor-quota "$action";; *) echo '{"error":"Invalid action"}';; esac ;;
		esac ;;
esac
